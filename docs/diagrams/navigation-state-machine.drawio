        </mxCell>
        <mxCell id="head_explore" value="02  探索状态机" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="644" y="170" width="572" height="35" />
        </mxCell>
        <mxCell id="sub_explore" value="core/ · 状态计算，不直接调用设备或模型" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="644" y="210" width="572" height="45" />
        </mxCell>
        <mxCell id="panel_target" value="" style="rounded=1;arcSize=2;fillColor=#fbfcfe;strokeColor=#d9e1ec;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="150" width="710" height="1860" />
        </mxCell>
        <mxCell id="head_target" value="03  目标处理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1284" y="170" width="662" height="35" />
        </mxCell>
        <mxCell id="sub_target" value="目标线索优先；普通模型队列在处理期间暂停" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1284" y="210" width="662" height="45" />
        </mxCell>
        <mxCell id="panel_async" value="" style="rounded=1;arcSize=2;fillColor=#fbfcfe;strokeColor=#d9e1ec;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1990" y="150" width="620" height="1860" />
        </mxCell>
        <mxCell id="head_async" value="04  后台感知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2014" y="170" width="572" height="35" />
        </mxCell>
        <mxCell id="sub_async" value="perception/ · 逐图提交，FIFO 串行分析" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2014" y="210" width="572" height="45" />
        </mxCell>
        <mxCell id="title" value="机器人语义搜索 · 核心运行状态机" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1800" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="Habitat / Hermes 共用主流程 · 状态框保留 SearchPhase 原名；同名 A/B/C/D 端口表示跨区连接" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="85" width="2520" height="40" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;启动与装配&lt;/b&gt;&lt;br&gt;读取并校验配置 → 创建感知 → 创建设备&lt;br&gt;YOLOE / 已选本地 Qwen 预热；Hermes 启动前移&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;launch.py::_assemble_and_run / environment.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="280" width="440" height="120" />
        </mxCell>
        <mxCell id="frame" value="&lt;b&gt;取帧与接收结果 · 接口 D&lt;/b&gt;&lt;br&gt;位姿 + RGB-D + 地图；接收后台增量&lt;br&gt;更新 SearchState，优先领取下一条目标线索&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;app.py::run_navigation_cycle / _prepare_state&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="450" width="440" height="110" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;b&gt;navigate() 行为分派&lt;/b&gt;&lt;br&gt;已有目标线索 / 物体历史 → B&lt;br&gt;否则按当前探索阶段 → A&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;core/navigator.py::navigate&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="610" width="440" height="105" />
        </mxCell>
        <mxCell id="supply" value="&lt;b&gt;补充核心请求，完成本轮决策&lt;/b&gt;&lt;br&gt;采图 → 单图入队 C；缓存评分 → 直接选点&lt;br&gt;历史定位 → 停底盘后调用感知，再交回核心&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;app.py::_supply_perception&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="765" width="440" height="115" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;同步执行 NavigationAction&lt;/b&gt;&lt;br&gt;Adapter 执行转向或移动并监控结果&lt;br&gt;视频继续进入 YOLOE；命中不取消动作&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;app.py::_execute_action&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="930" width="440" height="110" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b&gt;执行反馈 → 状态更新&lt;/b&gt;&lt;br&gt;成功继续；可恢复失败按动作用途处理&lt;br&gt;保留实际位置，不假装到达或已检查&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;core/navigator.py::apply_execution_result&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="1090" width="440" height="110" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;终态或继续？&lt;/b&gt;&lt;br&gt;未终止：保存状态，下一周期重新取帧&lt;br&gt;纯等待不消耗 max_cycles 决策额度" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#9ba8b8;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="1250" width="440" height="110" />
        </mxCell>
        <mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="frame">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frame" target="dispatch">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dispatch" target="supply">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supply" target="execute">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="execute" target="feedback">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="feedback" target="next">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="loop" value="下一周期" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="next" target="frame">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="65" y="1305" />
              <mxPoint x="65" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;动作失败的恢复规则&lt;/b&gt;&lt;br&gt;扫描转向：按真实朝向重建扫描&lt;br&gt;探索失败：排除尝试点；未知超限/阻塞屏蔽区域&lt;br&gt;回退失败：跳过返回节点、释放其暂存方向&lt;br&gt;场景返回失败：丢弃线索；物体停靠失败：换点" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#c99740;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="1440" width="440" height="185" />
        </mxCell>
        <mxCell id="wall" value="&lt;b&gt;Hermes 阻塞处理&lt;/b&gt;&lt;br&gt;连续 5 秒未离开 0.25 m 半径 → 人工墙&lt;br&gt;取消并确认终态后反馈 PATH_BLOCKED&lt;br&gt;墙在本次运行持续生效，限制后续路径&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;adapters/hermes/adapter.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#c99740;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="1675" width="440" height="130" />
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;运行退出与资源收尾&lt;/b&gt;&lt;br&gt;COMPLETE → 0；STOPPED → 3&lt;br&gt;FAILED / 周期上限 → 1；系统异常中止&lt;br&gt;退出关闭设备、感知及日志" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fceeed;strokeColor=#bc706d;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="1860" width="440" height="120" />
        </mxCell>
        <mxCell id="A" value="&lt;b&gt;A · 常规探索入口&lt;/b&gt;&lt;br&gt;启动或探索移动后进入 SCANNING" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;arcSize=50;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="280" width="430" height="70" />
        </mxCell>
        <mxCell id="scan" value="&lt;b&gt;SCANNING · 局部扫描&lt;/b&gt;&lt;br&gt;规划未检查的局部 Frontier 方向&lt;br&gt;转向到位 → 采集单张历史 RGB-D → C&lt;br&gt;无待查方向：仍采当前图，不额外转向&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;scan.py::continue_scanning&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="405" width="430" height="145" />
        </mxCell>
        <mxCell id="select" value="&lt;b&gt;EXPLORING · Frontier 选点&lt;/b&gt;&lt;br&gt;提取可达边界，过滤失效/已尝试/屏蔽区域&lt;br&gt;优先新候选：几何分 + 已返回的语义分&lt;br&gt;缺语义分用几何分；未选新方向暂存&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;exploration.py::select_exploration_target&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="625" width="430" height="145" />
        </mxCell>
        <mxCell id="move" value="&lt;b&gt;提交探索移动&lt;/b&gt;&lt;br&gt;记录分支历史，执行选中 Frontier 命令&lt;br&gt;提交时预置 SCANNING；同步运动后再取帧&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;exploration.py::commit_frontier_move&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="840" width="430" height="100" />
        </mxCell>
        <mxCell id="back" value="&lt;b&gt;BACKTRACKING · 逐级回退&lt;/b&gt;&lt;br&gt;新方向耗尽 → 返回当前分支栈顶节点&lt;br&gt;距节点 ≤ 0.25 m：刷新候选，不额外扫描&lt;br&gt;有暂存方向按原顺序恢复；无方向再退一层&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;exploration.py::begin_backtracking&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="1020" width="430" height="145" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;WAITING_FOR_SEMANTICS&lt;/b&gt;&lt;br&gt;分支耗尽但后台工作/线索未处理完：原地等&lt;br&gt;新线索 → B；出现新候选/待查边界 → 扫描&lt;br&gt;结果失败不等于“已经检查”&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;exploration.py::wait_for_semantics_or_finish&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#628ac4;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="1240" width="430" height="140" />
        </mxCell>
        <mxCell id="failed" value="&lt;b&gt;FAILED · 探索方向耗尽&lt;/b&gt;&lt;br&gt;没有有效方向，且队列与线索已经耗尽&lt;br&gt;NO_SOLUTION / explore.exhausted" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fceeed;strokeColor=#bc706d;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="1470" width="430" height="100" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A" target="scan">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a2" value="本轮方向采集结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scan" target="select">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="scanloop" value="下一方向 / 转向恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=1;entryY=0.8;" edge="1" parent="1" source="scan" target="scan">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1180" y="445" />
              <mxPoint x="1195" y="445" />
              <mxPoint x="1195" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" value="有新候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="select" target="move">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a4" value="移动完成 / 可恢复失败后重查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="move" target="scan">
          <mxGeometry as="geometry" relative="1">
