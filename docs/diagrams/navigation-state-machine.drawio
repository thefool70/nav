              <mxPoint x="1205" y="697" />
              <mxPoint x="1205" y="1092" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="有有效暂存方向" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="back" target="move">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="backloop" value="无方向：退一层" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0.5;entryY=1;" edge="1" parent="1" source="back" target="back">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1170" y="1125" />
              <mxPoint x="1180" y="1195" />
              <mxPoint x="930" y="1195" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" value="分支栈耗尽；有待处理工作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="back" target="wait">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a8" value="耗尽且无方向 / 线索" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wait" target="failed">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a9" value="出现新候选 / 未查边界" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.24;" edge="1" parent="1" source="wait" target="scan">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="655" y="1310" />
              <mxPoint x="655" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="anote" value="&lt;b&gt;探索顺序与等待边界&lt;/b&gt;&lt;br&gt;返回节点显露新候选时，也可转入选点&lt;br&gt;若分支与队列已同时耗尽，可直接 FAILED&lt;br&gt;普通评分不会中断或修改正在执行的移动" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#9ba8b8;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="1650" width="430" height="135" />
        </mxCell>
        <mxCell id="aport" value="&lt;b&gt;A ↔ B · 目标处理优先&lt;/b&gt;&lt;br&gt;每周期先取线索；执行中的动作先同步结束&lt;br&gt;目标处理结束后，按其结果完成、停止或恢复探索" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#9ba8b8;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;arcSize=50;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="1840" width="430" height="115" />
        </mxCell>
        <mxCell id="B" value="&lt;b&gt;B · 激活目标线索&lt;/b&gt;&lt;br&gt;保留拍摄位姿、历史 RGB-D 与目标框&lt;br&gt;scene → 场景返回；object → 历史定位" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#52966c;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;arcSize=50;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="280" width="530" height="95" />
        </mxCell>
        <mxCell id="scene" value="&lt;b&gt;REVISITING_TARGET · 场景返回&lt;/b&gt;&lt;br&gt;返回拍摄点并对齐原朝向（≤ 0.25 m / ≤ 5°）&lt;br&gt;到位 → COMPLETE；无须再次调用 VLM&lt;br&gt;返回失败 / 坐标系不符 → 下一线索，耗尽回 A&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;target.py::continue_scene_target&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#52966c;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="440" width="530" height="125" />
        </mxCell>
        <mxCell id="localize" value="&lt;b&gt;LOCALIZING_OBJECT · 历史定位&lt;/b&gt;&lt;br&gt;复用置信度融合认可的历史框&lt;br&gt;YOLOE 掩码 → 框内深度 → 地图障碍射线&lt;br&gt;得到目标坐标才规划停靠；不再请求 VLM&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;target.py / perception/object_localizer.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#52966c;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="650" width="530" height="145" />
        </mxCell>
        <mxCell id="approach" value="&lt;b&gt;APPROACHING_OBJECT · 规划并接近&lt;/b&gt;&lt;br&gt;选择目标附近可达、有净空的停靠点并对准目标&lt;br&gt;命令成功 → COMPLETE，无到达后视觉复查&lt;br&gt;运动失败换点：每条线索最多 3 次停靠&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;target.py::plan_approach&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#52966c;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="870" width="530" height="135" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;当前线索失败 → 继续历史&lt;/b&gt;&lt;br&gt;无法定位 / 无停靠点 / 三次停靠失败&lt;br&gt;保持当前位置，取下一条线索 → 历史定位&lt;br&gt;线索暂时用完但仍有任务：恢复已有队列并等待&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;discard_object_clue / continue_object_history&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#c99740;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="1080" width="530" height="135" />
        </mxCell>
        <mxCell id="histend" value="&lt;b&gt;历史队列彻底耗尽&lt;/b&gt;&lt;br&gt;曾定位成功但未完成接近 → 恢复探索 A&lt;br&gt;全部历史都无法定位 → 保底返回首条拍摄位姿" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#c99740;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="1290" width="530" height="105" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;REVISITING_TARGET · 物体保底&lt;/b&gt;&lt;br&gt;返回首条线索拍摄点并恢复朝向&lt;br&gt;到位或返回失败均停止，不继续搜索&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;target.py::_return_to_capture&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#c99740;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="1470" width="530" height="105" />
        </mxCell>
        <mxCell id="stopped" value="&lt;b&gt;STOPPED · 停止但未完成&lt;/b&gt;&lt;br&gt;物体保底流程结束；CLI 退出码 3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fceeed;strokeColor=#bc706d;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
