              <mxPoint x="675" y="890" />
              <mxPoint x="675" y="477" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" value="无新候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="select" target="back">
          <mxGeometry as="geometry" relative="1">
