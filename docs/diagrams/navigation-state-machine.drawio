        <mxCell id="pause" value="&lt;b&gt;目标处理时的暂停规则&lt;/b&gt;&lt;br&gt;暂停普通 VLM 队列，迟到结果暂存&lt;br&gt;已开始请求和快照准备可收尾&lt;br&gt;需要更多历史线索时，仅恢复已有队列&lt;br&gt;YOLOE 继续限频检测；暂停时不新增视频任务" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#9ba8b8;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="1250" width="450" height="160" />
        </mxCell>
        <mxCell id="lifetime" value="&lt;b&gt;随车本地模型的生命周期&lt;/b&gt;&lt;br&gt;启动导航且选择本机 Qwen3.5-4B → 预热&lt;br&gt;连续 5 分钟无模型请求 → Ollama 卸载&lt;br&gt;没有保活心跳；下次请求重新加载&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;adapters/ollama_warmup.py / nav-vlm.service&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="1490" width="450" height="140" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;读图说明&lt;/b&gt;&lt;br&gt;蓝色：运行编排 / 探索状态&lt;br&gt;绿色：目标定位、返回与成功&lt;br&gt;紫色虚线：后台数据处理，不代表底盘动作&lt;br&gt;橙色：可恢复分支；红色：停止或失败&lt;br&gt;A/B/C/D：同名跨区端口，避免长线交叉" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#9ba8b8;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="1710" width="450" height="220" />
        </mxCell>
        <mxCell id="footer" value="实现映射：app.py 负责副作用与动作反馈；core/navigator.py 分派行为；SearchState 保存跨周期状态；SemanticPerception 保存队列与快照。&lt;br&gt;本图合并重复周期和局部辅助计算；蓝/绿状态名对应 SearchPhase，其他框表示操作或条件。系统故障、输入错误、用户中断或决策上限均可结束运行。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#334155;fontStyle=0;" vertex="1" parent="1">
