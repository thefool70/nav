        </mxCell>
        <mxCell id="complete" value="&lt;b&gt;COMPLETE · 搜索成功&lt;/b&gt;&lt;br&gt;场景返回到位 / 物体停靠命令成功&lt;br&gt;CLI 退出码 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#52966c;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="1850" width="530" height="105" />
        </mxCell>
        <mxCell id="b1" value="scene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B" target="scene">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b2" value="object" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="B" target="localize">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1310" y="327" />
              <mxPoint x="1310" y="722" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b3" value="定位成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="localize" target="approach">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b4" value="无可用停靠点 / 尝试耗尽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="approach" target="history">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b5" value="无法定位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="localize" target="history">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1920" y="722" />
              <mxPoint x="1920" y="1147" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b6" value="下一历史线索" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.72;" edge="1" parent="1" source="history" target="localize">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1290" y="1147" />
              <mxPoint x="1290" y="755" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b7" value="历史处理完" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="history" target="histend">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b8" value="从未定位成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="histend" target="fallback">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#60758d;fontColor=#60758d;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fallback" target="stopped">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b10" value="场景到位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#52966c;fontColor=#52966c;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="scene" target="complete">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1945" y="502" />
              <mxPoint x="1945" y="1902" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b11" value="停靠成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#52966c;fontColor=#52966c;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="approach" target="complete">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1330" y="937" />
              <mxPoint x="1330" y="1902" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="C" value="&lt;b&gt;C · 扫描图 + 限频 YOLOE&lt;/b&gt;&lt;br&gt;固定原图、同帧深度、位姿和相机标定&lt;br&gt;扫描图与中等分视频候选入队；高分直接交付" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;arcSize=50;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="280" width="450" height="100" />
        </mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;串行快照准备&lt;/b&gt;&lt;br&gt;RGB 打包、同帧深度复制到内存&lt;br&gt;准备一张即进入模型 FIFO&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;semantic_queue.py / snapshot_store.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="450" width="450" height="105" />
        </mxCell>
        <mxCell id="vlm" value="&lt;b&gt;单图 VLM 分析&lt;/b&gt;&lt;br&gt;物体：score + 框 + confidence；场景：found + confidence&lt;br&gt;逐项校验：检测失败与有效未命中分开&lt;br&gt;本地 Qwen：关闭思考 + JSON Schema&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;openai_compatible.py / perception/analyzer.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="625" width="450" height="125" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;保存结果，等待主循环接收&lt;/b&gt;&lt;br&gt;图像分数赋给同图可见候选；首次有效分保留&lt;br&gt;高分单路 / 中等分同框联合：保留目标框与深度&lt;br&gt;有效扫描检测才登记已检查覆盖；失败单独记录" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="825" width="450" height="140" />
        </mxCell>
        <mxCell id="D" value="&lt;b&gt;D · 下一周期合入主循环&lt;/b&gt;&lt;br&gt;begin_cycle → receive_perception&lt;br&gt;分数用于后续选点；线索按可用顺序进入 B&lt;br&gt;后台不控制底盘，不直接修改 SearchState&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;app.py::_prepare_state / core/navigator.py&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1ecfb;strokeColor=#9675bd;strokeWidth=1.5;fontColor=#20324a;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;align=center;verticalAlign=middle;arcSize=50;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2075" y="1040" width="450" height="120" />
        </mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#9675bd;fontColor=#9675bd;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="C" target="snapshot">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#9675bd;fontColor=#9675bd;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="snapshot" target="vlm">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#9675bd;fontColor=#9675bd;fontSize=13;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="vlm" target="cache">
