            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="scan_note" value="无待查方向时，仍采当前画面检查目标。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=15;fontColor=#62758b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="415" width="640" height="32" />
        </mxCell>
        <mxCell id="back_note" value="无新方向：逐级回退父节点&lt;br&gt;按原顺序恢复暂存方向，再移动" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=14;fontColor=#62758b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="403" width="370" height="55" />
        </mxCell>
        <mxCell id="queue" value="&lt;b style=&quot;font-size:23px&quot;&gt;扫描图 + 限频 YOLOE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;扫描图与中等分视频候选入队&lt;br&gt;高分 YOLOE 直接形成线索&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#f2edfc;strokeColor=#b4a0d3;strokeWidth=1.5;fontColor=#654d8a;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="595" width="280" height="125" />
        </mxCell>
        <mxCell id="vlm" value="&lt;b style=&quot;font-size:23px&quot;&gt;VLM 单图推理&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;原图评分 + 框选 + 置信度&lt;br&gt;场景模式判断是否已在场景内&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#f2edfc;strokeColor=#b4a0d3;strokeWidth=1.5;fontColor=#654d8a;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="805" y="595" width="260" height="125" />
        </mxCell>
        <mxCell id="result" value="&lt;b style=&quot;font-size:23px&quot;&gt;接收评分与目标线索&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;图片分数关联同图可见候选&lt;br&gt;高分单路 / 中等分同框联合命中&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#f2edfc;strokeColor=#b4a0d3;strokeWidth=1.5;fontColor=#654d8a;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="595" width="280" height="125" />
        </mxCell>
        <mxCell id="submit" value="每采一张，立即提交" source="capture" target="queue" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9374b5;fontColor=#9374b5;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;">
