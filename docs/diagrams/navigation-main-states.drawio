          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="p4" value="移动完成，更新地图并开始下一轮扫描" source="move" target="plan" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6988ac;fontColor=#6988ac;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;">
