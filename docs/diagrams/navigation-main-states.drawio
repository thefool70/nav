        </mxCell>
        <mxCell id="h2" value="02  后台视觉推理" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=21;fontColor=#715395;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="525" width="360" height="36" />
        </mxCell>
        <mxCell id="h2sub" value="与扫描、移动并行" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#8c79a4;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="568" width="340" height="30" />
        </mxCell>
        <mxCell id="h3" value="03  目标处理" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=21;fontColor=#397558;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="859" width="600" height="36" />
        </mxCell>
        <mxCell id="plan" value="&lt;b style=&quot;font-size:23px&quot;&gt;更新地图 · 规划扫描&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;提取局部 Frontier 边界&lt;br&gt;结合已检查 / 待分析覆盖规划方向&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf4ff;strokeColor=#8aaad2;strokeWidth=1.5;fontColor=#294b74;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="260" width="280" height="125" />
        </mxCell>
        <mxCell id="capture" value="&lt;b style=&quot;font-size:23px&quot;&gt;逐方向转向 · 采图&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;朝向确认后固定单张 RGB-D&lt;br&gt;保留拍摄位姿与相机标定&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf4ff;strokeColor=#8aaad2;strokeWidth=1.5;fontColor=#294b74;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="460" y="260" width="280" height="125" />
        </mxCell>
        <mxCell id="select" value="&lt;b style=&quot;font-size:23px&quot;&gt;筛选候选 · 选点&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;可达候选的几何分 + 已有语义分&lt;br&gt;优先新方向，其余方向暂存&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf4ff;strokeColor=#8aaad2;strokeWidth=1.5;fontColor=#294b74;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1100" y="260" width="290" height="125" />
        </mxCell>
        <mxCell id="move" value="&lt;b style=&quot;font-size:23px&quot;&gt;移动到选定位置&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;执行运动并获取实际反馈&lt;br&gt;视频持续进入 YOLOE 队列&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf4ff;strokeColor=#8aaad2;strokeWidth=1.5;fontColor=#294b74;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="260" width="230" height="125" />
        </mxCell>
        <mxCell id="p1" value="" source="plan" target="capture" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6988ac;fontColor=#6988ac;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
