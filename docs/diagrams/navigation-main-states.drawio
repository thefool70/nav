          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="score" value="① 已返回的方向评分" source="result" target="select" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9374b5;fontColor=#9374b5;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.4;exitY=0;entryX=0.48;entryY=1;dashed=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="no_wait" value="选点不等本轮推理&lt;br&gt;缺分时只用几何分" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=18;fontColor=#715395;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="610" width="255" height="75" />
        </mxCell>
        <mxCell id="score_note" value="同图可见的多个候选共用图片分数；评分只影响后续选点，不改变正在执行的移动。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#62758b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="778" width="1610" height="35" />
        </mxCell>
        <mxCell id="clue" value="&lt;b style=&quot;font-size:23px&quot;&gt;优先处理目标线索&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;下一个决策周期接收&lt;br&gt;当前线索失败先尝试其他历史线索&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf8f2;strokeColor=#8fc5a9;strokeWidth=1.5;fontColor=#296a4d;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="130" y="995" width="330" height="135" />
        </mxCell>
        <mxCell id="scene" value="&lt;b style=&quot;font-size:23px&quot;&gt;场景：返回拍摄位姿&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;回到当时的位置，并对齐朝向&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf8f2;strokeColor=#8fc5a9;strokeWidth=1.5;fontColor=#296a4d;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="920" width="340" height="110" />
        </mxCell>
        <mxCell id="object" value="&lt;b style=&quot;font-size:23px&quot;&gt;物体：历史 RGB-D 定位&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;复用认可目标框 + YOLOE&lt;br&gt;深度优先，地图障碍射线作为保底&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf8f2;strokeColor=#8fc5a9;strokeWidth=1.5;fontColor=#296a4d;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="1120" width="340" height="110" />
        </mxCell>
        <mxCell id="approach" value="&lt;b style=&quot;font-size:23px&quot;&gt;规划停靠 · 接近&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;选择目标附近的可达停靠点&lt;br&gt;移动并对准目标&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf8f2;strokeColor=#8fc5a9;strokeWidth=1.5;fontColor=#296a4d;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="1120" width="280" height="110" />
        </mxCell>
        <mxCell id="done" value="&lt;b style=&quot;font-size:23px&quot;&gt;搜索完成&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;场景返回到位&lt;br&gt;或物体停靠命令成功&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;rounded=1;arcSize=14;fillColor=#edf8f2;strokeColor=#8fc5a9;strokeWidth=1.5;fontColor=#296a4d;align=center;verticalAlign=middle;spacing=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="1000" width="220" height="125" />
        </mxCell>
        <mxCell id="trigger" value="② 目标线索：转入目标处理" source="result" target="clue" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.5;entryY=0;dashed=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1326" y="825" />
              <mxPoint x="295" y="825" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cs" value="场景" source="clue" target="scene" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="1029" />
              <mxPoint x="560" y="975" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="co" value="物体" source="clue" target="object" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="1096" />
              <mxPoint x="560" y="1175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="oa" value="定位成功" source="object" target="approach" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sd" value="到位" source="scene" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1600" y="975" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ad" value="停靠成功" source="approach" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4c936e;fontColor=#4c936e;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1600" y="1175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rules_title" value="图中保留的是算法主干" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=18;fontColor=#42576c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1300" width="600" height="30" />
        </mxCell>
        <mxCell id="rules" value="• 每个导航周期先接收后台结果；线索优先于探索，但不抢占已下发的动作。目标处理期间暂停 VLM 队列，YOLOE 仍运行。&lt;br&gt;• 探索方向耗尽时再等队列；目标处理失败先用完历史线索，再按条件恢复探索或保底停止。&lt;br&gt;• 箭头实线表示执行顺序，虚线表示异步提交或结果传递。局部重试、终态与资源管理未展开。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=16;fontColor=#62758b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1340" width="1620" height="95" />
        </mxCell>
        <mxCell id="yolo_direct" source="queue" target="result" value="YOLOE 高分直接交付" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9374b5;fontColor=#654d8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="600" y="555" />
              <mxPoint x="1270" y="555" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>