        <mxCell id="qv" value="" source="queue" target="vlm" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=15;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9374b5;fontColor=#9374b5;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;">
