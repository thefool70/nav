        <mxCell id="h1" value="01  探索主线" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;text;align=left;verticalAlign=middle;fontSize=21;fontColor=#385d88;fontStyle=1;" vertex="1" parent="1">
